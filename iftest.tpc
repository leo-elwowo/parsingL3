int globale_multiplicateur;

// Une fonction qui fait un calcul avec des arguments
int calculer_degats(int attaque, int bonus) {
    int total;
    total = attaque + bonus;
    return total * globale_multiplicateur;
}

int main(void) {
    int degats_finaux;
    
    globale_multiplicateur = 2; // Coup critique !
    
    // Appel avec des arguments
    degats_finaux = calculer_degats(10, 5); 
    
    return degats_finaux; // Devrait renvoyer 30 ( (10+5) * 2 )
}