int th_level;
int a_assez_or;
int peut_ameliorer;

int main(void) {
    th_level = 11;
    a_assez_or = 1;
    
    // Test du AND (les deux doivent être vrais)
    // Comme a_assez_or vaut 0, ça doit court-circuiter et aller dans le else
    if (th_level > 10 && a_assez_or) {
        peut_ameliorer = 1;
    } else {
        peut_ameliorer = 0;
    }
    
    return peut_ameliorer;
}